# Шаблон конфигурации для запуска через Docker Compose.
# Скопируйте в .env и замените значения. .env не должен попадать в Git.

# Django
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Кодировка вывода Python на Windows.
PYTHONIOENCODING=utf-8

# PostgreSQL
DB_NAME=sky_habit
DB_USER=postgres
DB_PASSWORD=postgres
# Хост и порт БД внутри docker-сети.
DB_HOST=db
DB_PORT=5432
# Порт PostgreSQL, проброшенный на хост.
DB_HOST_PORT=5433

# Redis / Celery
# Адреса Redis внутри docker-сети.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Порт Redis, проброшенный на хост.
REDIS_HOST_PORT=6380

# Telegram-бот, оставьте пустым, если бот не нужен.
TELEGRAM_BOT_TOKEN=
